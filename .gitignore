# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Local configuration and credentials
.env
.env.*
!.env.example

# Jupyter / IDE / tooling
.ipynb_checkpoints/
.vscode/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw, intermediate, and generated data
data/raw/*
data/interim/*
data/processed/*
data/predictions/*

# Preserve folder placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/predictions/.gitkeep

# Preserve the original development split used for reproducible training
!data/processed/default_risk_development_ids.csv

# Trained model artifacts (not committed by default)
models/*
!models/.gitkeep

# Logs
*.log
logs/

# Power BI report: add final PBIX at project completion
powerbi/*.pbix

# OS / temporary files
.DS_Store
Thumbs.db
*.tmp
*.temp
