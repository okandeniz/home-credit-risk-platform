# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Local configuration, tokens, and credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Notebooks, editors, tests, and linters
.ipynb_checkpoints/
.vscode/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local datasets and prediction exports
# The source Kaggle data is downloaded separately.
data/raw/*
data/interim/*
data/processed/*
data/predictions/*

# Keep intentional directory placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/predictions/.gitkeep

# Reproducible development split used by train.py
!data/processed/default_risk_development_ids.csv

# Trained model artifacts are generated locally
models/*
!models/.gitkeep

# Runtime logs and temporary files
*.log
logs/
*.tmp
*.temp
.DS_Store
Thumbs.db

# Power BI: final .pbix report IS intentionally tracked.
# Ignore temporary/lock files, not the .pbix itself.
~$*.pbix
